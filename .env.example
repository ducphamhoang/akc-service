# akc-service environment configuration
# Copy this file to .env and edit values as needed.
# The .env file is gitignored — never commit it with real values.

# Safety level for AKC service operations. Allowed values: 0, 1, or 2.
# 0 = permissive, 1 = standard (default), 2 = strict
AKC_SERVICE_SAFETY_LEVEL=1

# Base URL of the AKC service. Must be reachable from the agent-system host.
AKC_SERVICE_URL=http://localhost:8000
